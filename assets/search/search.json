---
layout: null
permalink: /assets/search/search.json
---
{% assign search_documents = site.pages | concat: site.posts | concat: site.projects | concat: site.publications | concat: site.talks | concat: site.teaching | concat: site.portfolio %}
{% assign first_entry = true %}
[
{% for document in search_documents %}
  {% if document.title and document.search != false and document.url != "/assets/search/search.json" %}
    {% unless first_entry %},{% endunless %}
    {% capture search_body %}{{ document.content | markdownify | strip_html | normalize_whitespace }}{% endcapture %}
    {% capture search_title %}{{ document.title | markdownify | strip_html | normalize_whitespace }}{% endcapture %}
    {"title":{{ search_title | jsonify }},"url":{{ document.url | relative_url | jsonify }},"content":{{ search_body | jsonify }}}
    {% assign first_entry = false %}
  {% endif %}
{% endfor %}
]
